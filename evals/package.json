{
  "name": "chat-agent-evals",
  "private": true,
  "type": "module",
  "description": "Separate test harness for the chat agent (Promptfoo). Kept out of the app's dependencies.",
  "scripts": {
    "seed": "tsx --env-file=../.env seed-history.ts",
    "serve": "cd .. && DB_PATH=data/eval.db AGENT_NOW=2026-11-12T08:00:00Z PORT=3100 npx tsx --env-file=.env src/server.ts",
    "eval": "promptfoo eval -c regression.yaml --no-cache --env-file ../.env",
    "eval:sim": "promptfoo eval -c simulated-users.yaml --no-cache --env-file ../.env",
    "redteam": "promptfoo redteam run -c redteam.yaml -o redteam-generated.yaml --no-cache --env-file ../.env -j 1 --delay 6000",
    "view": "promptfoo view",
    "redteam:rerun": "promptfoo eval -c redteam-generated.yaml --no-cache --env-file ../.env -j 1 --delay 6000 -o results/redteam.json"
  },
  "devDependencies": {
    "promptfoo": "^0.125.1",
    "tsx": "^4.23.15"
  }
}