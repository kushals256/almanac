# Required (free tiers): the primary LLM and the primary search.
GROQ_API_KEY=        # https://console.groq.com/keys        planner, answerer, extractor
EXA_API_KEY=         # https://dashboard.exa.ai             primary search + page reads
# Optional fallbacks (free tiers). Without one, the agent runs and degrades (listed at boot and on /health):
NVIDIA_API_KEY=      # https://build.nvidia.com             fallback LLMs + meaning-based recall (embeddings)
TAVILY_API_KEY=      # https://app.tavily.com               backup search provider
OPENROUTER_API_KEY=  # https://openrouter.ai/keys           Jev decision model (else the LLM judges)
# Optional settings
# PORT=3000
# DB_PATH=data/agent.db
